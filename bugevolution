task.spawn(function()
    while task.wait(1) do
        if Config.Enabled and Config.AutoSpin then
            pcall(function()
                VoidAction:InvokeServer("Spin")
                task.wait(0.1)
                VoidAction:InvokeServer("Credits", {Spins = 1, Credits = 500, Cost = 500})
            end)
            task.wait(2) 
        end
    end
end)

-- ==========================================
-- MAIN COMBAT LOOP
-- ==========================================
RunService.RenderStepped:Connect(function()
    if not Config.Enabled then return end
    if tick() - lastAttack < Config.AttackCooldown then return end

    local target, targetType = getClosestTarget()
    
    if target and target ~= currentTarget then
        currentTarget = target
        targetStartTime = tick()
        targetStartHealth = target:FindFirstChild("Humanoid") and target.Humanoid.Health or 0
    end

    if target then
        lastAttack = tick()
        local targetPos = getSafePosition(target)
        local myChar = LocalPlayer.Character
        
        if Config.TeleportEnabled and targetPos and myChar and myChar:FindFirstChild("HumanoidRootPart") then
            myChar.HumanoidRootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
            
            if targetType == "Void" or targetType == "Orb" or targetType == "Sand" then
                task.wait(0.15) 
            end
        end

        if targetType == "Bug" then
            task.wait(2.0) 
            if target and target:FindFirstChild("Humanoid") and target.Humanoid.Health >= targetStartHealth then
                ignoredBugs[target] = true
                currentTarget = nil 
                task.delay(5, function() ignoredBugs[target] = nil end)
            end
        end
    end
end)

