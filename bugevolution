        Config[name] = not Config[name]
        btn.BackgroundColor3 = Config[name] and Colors.Accent or Colors.Panel
        btn.TextColor3 = Config[name] and Colors.Text or Colors.TextDim
        if name == "ESP" then updateAllESP() end
    end)
end

