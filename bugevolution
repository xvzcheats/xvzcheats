local draggingRange = false
local draggingSpeed = false
local draggingFly = false

RangeSlider.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not Config.InfiniteRange then draggingRange = true end
end)

SpeedSlider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSpeed = true end
end)

FlySlider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingFly = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingRange = false
        draggingSpeed = false
        draggingFly = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if draggingRange then
            local percent = math.clamp((input.Position.X - RangeSlider.AbsolutePosition.X) / RangeSlider.AbsoluteSize.X, 0.01, 1)
            RangeFill.Size = UDim2.new(percent, 0, 1, 0)
            Config.Range = math.floor(percent * 2000) 
        elseif draggingSpeed then
            local percent = math.clamp((input.Position.X - SpeedSlider.AbsolutePosition.X) / SpeedSlider.AbsoluteSize.X, 0.064, 1) 
            SpeedFill.Size = UDim2.new(percent, 0, 1, 0)
            Config.WalkSpeed = math.floor(percent * 250) 
            ApplySpeed()
        elseif draggingFly then
            local percent = math.clamp((input.Position.X - FlySlider.AbsolutePosition.X) / FlySlider.AbsoluteSize.X, 0.02, 1) 
            FlyFill.Size = UDim2.new(percent, 0, 1, 0)
            Config.FlySpeed = math.floor(percent * 200) 
        end
    end
end)

