local function CreateToggle(name, text, defaultState, pos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.48, 0, 0, 30)
    btn.Position = pos
    btn.BackgroundColor3 = defaultState and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.Parent = TogglesFrame
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn
    btn.MouseButton1Click:Connect(function()
        Config[name] = not Config[name]
        btn.BackgroundColor3 = Config[name] and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
        if name == "ESP" then updateAllESP() end
    end)
    return btn
end

