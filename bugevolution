-- ==========================================
-- ANTI-CHEAT WALKSPEED BYPASS
-- ==========================================
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
    if key == "WalkSpeed" and self:IsA("Humanoid") then
        if Config.SpeedEnabled then return Config.WalkSpeed end
    end
    return oldIndex(self, key)
end)

local oldNewIndex
oldNewIndex = hookmetamethod(game, "__newindex", function(self, key, value)
    if key == "WalkSpeed" and self:IsA("Humanoid") then
        if Config.SpeedEnabled then return end
    end
    return oldNewIndex(self, key, value)
end)

local function ApplySpeed()
    if Config.SpeedEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local tempEnabled = Config.SpeedEnabled
            Config.SpeedEnabled = false
            char.Humanoid.WalkSpeed = Config.WalkSpeed
            Config.SpeedEnabled = tempEnabled
        end
    end
end

-- ==========================================
-- FLY SYSTEM
-- ==========================================
function StartFlying()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    StopFlying() 

    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = root

    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.P = 1000
    flyBG.Parent = root

    flyConnection = RunService.RenderStepped:Connect(function()
        if not Config.FlyEnabled or not flyBV or not flyBG then return end
        local camera = workspace.CurrentCamera
        local moveDirection = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection += camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection -= camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection -= camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection += camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDirection -= Vector3.new(0, 1, 0) end

        flyBV.Velocity = moveDirection.Magnitude > 0 and moveDirection.Unit * Config.FlySpeed or Vector3.zero
        flyBG.CFrame = camera.CFrame
    end)
end

function StopFlying()
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
end

