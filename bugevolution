-- ESP SYSTEM
-- ==========================================
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "PlayerESP"
ESPFolder.Parent = game:GetService("CoreGui")

local function createESP(player)
    if player == LocalPlayer then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = player.Name .. "_Highlight"
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = ESPFolder
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = player.Name .. "_Billboard"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 150, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.SizeOffset = Vector2.new(1, 1) 
    billboard.Parent = ESPFolder

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextStrokeTransparency = 0
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextScaled = true
    textLabel.Parent = billboard
    
    local function updateESP(char)
        if not char then return end
        highlight.Adornee = char
        local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if not root then
            char.ChildAdded:Connect(function(child)
                if child.Name == "HumanoidRootPart" or child == char.PrimaryPart then billboard.Adornee = child end
            end)
        else
            billboard.Adornee = root
        end
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            local function updateHealth()
                local currentHealth = math.floor(hum.Health)
                local maxHealth = math.floor(hum.MaxHealth)
                textLabel.Text = player.DisplayName .. " [" .. currentHealth .. "/" .. maxHealth .. "]"
            end
            updateHealth()
            hum.HealthChanged:Connect(updateHealth)
        end
    end
    updateESP(player.Character)
    player.CharacterAdded:Connect(updateESP)
end

local function removeESP(player)
    local highlight = ESPFolder:FindFirstChild(player.Name .. "_Highlight")
    local billboard = ESPFolder:FindFirstChild(player.Name .. "_Billboard")
    if highlight then highlight:Destroy() end
    if billboard then billboard:Destroy() end
end

local function updateAllESP()
    for _, player in pairs(Players:GetPlayers()) do
        if Config.ESP then
            if not ESPFolder:FindFirstChild(player.Name .. "_Highlight") then createESP(player) end
        else
            removeESP(player)
        end
    end
end

Players.PlayerAdded:Connect(function(player) if Config.ESP then createESP(player) end end)
Players.PlayerRemoving:Connect(function(player) removeESP(player) end)

-- ==========================================
-- SAFE POSITION HELPER
-- ==========================================
local function getSafePosition(obj)
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position
        else
            local success, pivot = pcall(function() return obj:GetPivot().Position end)
            if success then return pivot end
        end
    elseif obj:IsA("BasePart") then return obj.Position end
    return nil
end

-- ==========================================
-- TARGETING LOGIC
-- ==========================================
local function getClosestTarget()
    local closest = nil
    local shortestDistance = math.huge
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil, nil end
    local myPos = myChar.HumanoidRootPart.Position

    local function isValidDistance(dist)
        if Config.InfiniteRange then return true end
        return dist <= Config.Range
    end

    if Config.EatCorpses then
        local foldersToCheck = { workspace:FindFirstChild("Bugs"), workspace:FindFirstChild("Nests"), workspace }
        for _, folder in pairs(foldersToCheck) do
            if folder then
                for _, obj in pairs(folder:GetChildren()) do
                    if obj:GetAttribute("Corpse") == true or obj.Name:find("Corpse") then
                        local pos = getSafePosition(obj)
                        if pos then
                            local dist = (myPos - pos).Magnitude
                            if isValidDistance(dist) and dist < shortestDistance then
                                shortestDistance = dist
                                closest = obj
                            end
                        end
                    end
                end
            end
        end
        if closest then return closest, "Corpse" end
    end

    if Config.TargetVoid then
        local voidFolder = workspace:FindFirstChild("VoidOrbs")
        if voidFolder then
            for _, orb in pairs(voidFolder:GetDescendants()) do
                if orb.Name == "VoidOrb" and (orb:IsA("Model") or orb:IsA("BasePart")) then
                    local pos = getSafePosition(orb)
                    if pos then
                        local dist = (myPos - pos).Magnitude
                        if isValidDistance(dist) and dist < shortestDistance then
                            shortestDistance = dist
                            closest = orb
                        end
                    end
                end
            end
        end
        if closest then return closest, "Void" end
    end

    if Config.TargetSand then
        local sandFolder = workspace:FindFirstChild("SandOrbs")
        if sandFolder then
            for _, orb in pairs(sandFolder:GetDescendants()) do
                if orb.Name == "SandOrb" and (orb:IsA("Model") or orb:IsA("BasePart")) then
                    local pos = getSafePosition(orb)
                    if pos then
                        local dist = (myPos - pos).Magnitude
                        if isValidDistance(dist) and dist < shortestDistance then
                            shortestDistance = dist
                            closest = orb
                        end
                    end
                end
            end
        end
        if closest then return closest, "Sand" end
    end

    if Config.TargetOrbs then
        local orbFolder = workspace:FindFirstChild("Orbs")
        if orbFolder then
            for _, orb in pairs(orbFolder:GetChildren()) do
                if orb.Name == "Orb" and orb:GetAttribute("XP") then
                    local pos = getSafePosition(orb)
                    if pos then
                        local dist = (myPos - pos).Magnitude
                        if isValidDistance(dist) and dist < shortestDistance then
                            shortestDistance = dist
                            closest = orb
                        end
                    end
                end
            end
        end
        if closest then return closest, "Orb" end
    end

    if Config.TargetPlayers or Config.TargetAIBugs then
        if Config.TargetPlayers then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local char = player.Character
                    if char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
                        if char.Humanoid.Health > 0 and not ignoredBugs[char] and char:GetAttribute("Corpse") ~= true then
                            local dist = (myPos - char.HumanoidRootPart.Position).Magnitude
                            if isValidDistance(dist) and dist < shortestDistance then
                                shortestDistance = dist
                                closest = char
                            end
                        end
                    end
                end
            end
            if closest then return closest, "Bug" end
        end

        if Config.TargetAIBugs then
            local aiFolders = { workspace:FindFirstChild("Bugs"), workspace:FindFirstChild("Nests") }
            for _, folder in pairs(aiFolders) do
                if folder then
                    for _, obj in pairs(folder:GetChildren()) do
                        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                            if obj.Humanoid.Health > 0 and not ignoredBugs[obj] and obj:GetAttribute("Corpse") ~= true then
                                local dist = (myPos - obj.HumanoidRootPart.Position).Magnitude
                                if isValidDistance(dist) and dist < shortestDistance then
                                    shortestDistance = dist
                                    closest = obj
                                end
                            end
                        end
                    end
                end
            end
            if closest then return closest, "Bug" end
        end
    end

    if Config.TargetObjects then
        local breakablesFolder = workspace:FindFirstChild("Breakables") or workspace
        for _, obj in pairs(breakablesFolder:GetChildren()) do
            if obj:IsA("Model") or obj:IsA("BasePart") then
                if obj:GetAttribute("Breakable") or obj.Name:find("Acorn") or obj.Name:find("Cocoon") or obj.Name:find("Silk") then
                    local objPos = getSafePosition(obj)
                    if objPos then
                        local dist = (myPos - objPos).Magnitude
                        if isValidDistance(dist) and dist < shortestDistance then
                            shortestDistance = dist
                            closest = obj
                        end
                    end
                end
            end
        end
        if closest then return closest, "Object" end
    end
    return nil, nil
end

