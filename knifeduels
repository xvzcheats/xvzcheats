-- // Knife Controller Hook //
local phem1 = Players
local phem2 = Workspace
local phem3 = lp
local phem4 = Camera
local phem5 = require(phem3.PlayerScripts:WaitForChild("Controllers"):WaitForChild("Combat"):WaitForChild("KnifeController"))

local function isVisible(part)
    if not getgenv().KnifeConfig.WallCheck then return true end
    local origin = phem4.CFrame.Position
    local direction = part.Position - origin
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {phem3.Character, phem4}
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    local result = phem2:Raycast(origin, direction, params)
    return result == nil or result.Instance:IsDescendantOf(part.Parent)
end

local function getTarget()
    if lockedTarget and lockedTarget.Character and lockedTarget.Character:FindFirstChild("Humanoid") and lockedTarget.Character.Humanoid.Health > 0 then
        local targetPart = lockedTarget.Character:FindFirstChild(getgenv().KnifeConfig.HitPart)
        if targetPart then
            local pos, onScreen = phem4:WorldToViewportPoint(targetPart.Position)
            local dist = (Vector2.new(pos.X, pos.Y) - (phem4.ViewportSize / 2)).Magnitude
            if onScreen and dist <= getgenv().KnifeConfig.FOV and isVisible(targetPart) then
                return lockedTarget
            end
        end
    end

    local bestTarget = nil
    local shortestDist = getgenv().KnifeConfig.FOV
    local center = phem4.ViewportSize / 2

    for _, player in ipairs(phem1:GetPlayers()) do
        if player ~= phem3 and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local hitPart = player.Character:FindFirstChild(getgenv().KnifeConfig.HitPart)
            if hitPart then
                local pos, onScreen = phem4:WorldToViewportPoint(hitPart.Position)
                if onScreen and isVisible(hitPart) then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist < shortestDist then
                        bestTarget = player
                        shortestDist = dist
                    end
                end
            end
        end
    end
    
    lockedTarget = bestTarget
    return bestTarget
end

local originalGetThrowDirection = phem5._GetThrowDirection
phem5._GetThrowDirection = function(self, originPart)
    if getgenv().KnifeConfig.Enabled then
        local targetPlayer = getTarget()
        if targetPlayer and targetPlayer.Character then
            local hitPart = targetPlayer.Character:FindFirstChild(getgenv().KnifeConfig.HitPart)
            if hitPart then
                return (hitPart.Position - originPart.Position).Unit
            end
        end
    end
    return originalGetThrowDirection(self, originPart)
end

-- // Helper Function for Right Click Throw //
local function doRightClick()
    if mouse2click then
        mouse2click()
    elseif mouse2press and mouse2release then
        mouse2press()
        task.wait(0.02)
        mouse2release()
    elseif VirtualInputManager then
        local mousePos = UserInputService:GetMouseLocation()
        VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 1, true, game, 0)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 1, false, game, 0)
    end
end

